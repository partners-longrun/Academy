{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/src/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(icon_192.png|icon_512.png|src/icon_192.png|src/icon_512.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)\\.gs", "destination": "/404" },
    { "source": "/README.md", "destination": "/404" },
    { "source": "/\\.agent/(.*)", "destination": "/404" },
    { "source": "/manifest.json", "destination": "/src/manifest.json" },
    { "source": "/sw.js", "destination": "/src/sw.js" },
    { "source": "/script.js", "destination": "/src/script.js" },
    { "source": "/style.css", "destination": "/src/style.css" },
    { "source": "/icon_192.png", "destination": "/src/icon_192.png" },
    { "source": "/icon_512.png", "destination": "/src/icon_512.png" },
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/(.*)", "destination": "/src/index.html" }
  ]
}
